# Copie para .env e preencha. Cada segredo: openssl rand -base64 32
# O .env nunca vai para o git. Na VPS: chmod 600 .env e cópia no cofre da TIC.

PG_ADMIN_SENHA=
TIC_N8N_SENHA=
TIC_LEITURA_SENHA=
PG_PORTA=5433

N8N_ENCRYPTION_KEY=
N8N_VERSAO=2.48.4
N8N_PORTA=5679

# Domínio na VPS (HTTPS automático); no computador do dev: http://localhost
TIC_SITE=localhost
TIC_URL=https://localhost/

# Chave da API do Claude na conta da TIC (só na VPS)
ANTHROPIC_API_KEY=

# Autotrac (docs/estudo-api-atic.md, spec ingestao-autotrac). Valores reais só no .env da VPS; viram a credencial
# "Autotrac (API)" do n8n com: sh scripts/n8n-credencial-autotrac.sh
# O scripts/testar-atic.mjs também lê estes (argumento telemetria ou atic).
AUTOTRAC_TELEMETRIA_URL=https://aapi4.autotrac-online.com.br/telemetryapi
AUTOTRAC_ATIC_URL=https://aapi3.autotrac-online.com.br/aticapi
AUTOTRAC_CONTA=
AUTOTRAC_CHAVE=
AUTOTRAC_USUARIO=
AUTOTRAC_SENHA=
